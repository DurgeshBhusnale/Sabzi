# Copy to .env.local (never commit real values).
# Public values (safe in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_NAME=Sabzi
EXPO_PUBLIC_PUBLIC_BASE_URL=https://sabzi.example
EXPO_PUBLIC_POSTHOG_KEY=

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets: set with `npx supabase secrets set` for edge functions, never in the apps
# SUPABASE_SERVICE_ROLE_KEY=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# EXPO_ACCESS_TOKEN=
